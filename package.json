{
  "name": "mugilu",
  "private": true,
  "version": "0.0.0",
  "description": "mugilu: India's open sky. Air, heat, rain, UV, dust, wind, fog, smoke and official warnings for any point in India.",
  "license": "MIT",
  "scripts": {
    "dev:worker": "pnpm --filter mugilu-worker dev",
    "dev:site": "pnpm --filter mugilu-site dev",
    "build:site": "pnpm --filter mugilu-site build",
    "deploy:worker": "pnpm --filter mugilu-worker deploy"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "undici@>=7.0.0 <7.29.1": "^7.29.1",
      "sharp@<0.35.4": "^0.35.4",
      "fflate@>=0.7.0 <0.7.5": "~0.7.5"
    }
  }
}
